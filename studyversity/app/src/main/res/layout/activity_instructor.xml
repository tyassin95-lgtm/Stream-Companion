<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/default_activity_bg"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?android:actionBarSize"
        android:background="@color/colorPrimary"
        android:theme="@style/Toolbar" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/instructorTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/iceBlue"
        app:tabGravity="fill"
        app:tabIndicatorColor="#ffe5b146"
        app:tabIndicatorFullWidth="false"
        app:tabMode="scrollable"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextColor="#ffe5b146"
        app:tabTextAppearance="@style/AppTheme.MoodTabText"
        app:tabTextColor="@color/darkBlueGreen" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/instructorPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
